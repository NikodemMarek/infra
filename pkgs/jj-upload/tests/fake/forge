#!/bin/sh
# Fake `forge` CLI. PRs are stored as contract-shaped JSON in $FAKE_FORGE_DIR/prs.json.
# Config files in $FAKE_FORGE_DIR: kind (gitlab|github), reopen_refuse, upload_fail (presence = on).
set -eu
d=${FAKE_FORGE_DIR:?FAKE_FORGE_DIR unset}
mkdir -p "$d"
jq -cn '$ARGS.positional' --args -- "$@" >> "$d/calls.log"
db=$d/prs.json
[ -f "$db" ] || echo '[]' > "$db"
kind=$(cat "$d/kind" 2>/dev/null || echo gitlab)
if [ "$kind" = gitlab ]; then
  host=gitlab.example.com project=g/p
else
  host=github.example.com project=o/p
fi

die() { echo "forge: $*" >&2; exit 1; }
usage() { echo "fake forge: unexpected argv: $*" >&2; exit 99; }

if [ "${1:-}" = --remote ]; then
  [ $# -ge 2 ] || usage "$@"
  shift 2
fi
[ $# -ge 1 ] || usage "$@"
cmd=$1
shift

save() { printf '%s\n' "$1" > "$db.tmp" && mv "$db.tmp" "$db"; }
pr_url() {
  if [ "$kind" = gitlab ]; then echo "https://$host/$project/-/merge_requests/$1"; else echo "https://$host/$project/pull/$1"; fi
}
get() { jq -ce --argjson n "$1" '.[] | select(.number==$n)' "$db"; }
need_pr() {
  case ${1:-} in ''|*[!0-9]*) usage "$@" ;; esac
  get "$1" || die "pull request $1 not found"
}
update() {
  save "$(jq -c --argjson n "$1" --argjson v "$2" 'map(if .number==$n then . + $v else . end)' "$db")"
  get "$1"
}

case $cmd in
  repo)
    [ $# -eq 0 ] || usage "$cmd" "$@"
    jq -cn --arg f "$kind" --arg h "$host" --arg p "$project" '{forge:$f,host:$h,project:$p}'
    ;;
  upload)
    [ $# -eq 1 ] || usage "$cmd" "$@"
    [ -f "$1" ] || die "no such file: $1"
    [ ! -e "$d/upload_fail" ] || die "upload failed"
    [ "$kind" = gitlab ] || die "github has no file upload API"
    echo '{"url":"/uploads/0123456789abcdef/'"$(basename "$1")"'"}'
    ;;
  pr)
    [ $# -ge 1 ] || usage "$cmd"
    sub=$1
    shift
    case $sub in
      list)
        head= limit=100
        while [ $# -gt 0 ]; do
          case $1 in
            --head) head=$2; shift 2 ;;
            --limit) limit=$2; shift 2 ;;
            *) usage pr list "$@" ;;
          esac
        done
        jq -c --arg h "$head" --argjson l "$limit" \
          '[.[] | select($h=="" or .head==$h)] | sort_by(-.number) | .[:$l]' "$db"
        ;;
      view)
        [ $# -eq 1 ] || usage pr view "$@"
        need_pr "$1"
        ;;
      create)
        head= base= title= body= draft=false have_title=0
        while [ $# -gt 0 ]; do
          case $1 in
            --head) head=$2; shift 2 ;;
            --base) base=$2; shift 2 ;;
            --title) title=$2; have_title=1; shift 2 ;;
            --body) body=$2; shift 2 ;;
            --draft) draft=true; shift ;;
            *) usage pr create "$@" ;;
          esac
        done
        [ -n "$head" ] && [ -n "$base" ] && [ "$have_title" = 1 ] || usage pr create "$@"
        n=$(jq 'map(.number)|max // 0|.+1' "$db")
        if [ "$kind" = gitlab ]; then r="!$n"; else r="#$n"; fi
        new=$(jq -cn --arg f "$kind" --argjson n "$n" --arg r "$r" --arg u "$(pr_url "$n")" \
          --arg t "$title" --arg b "$body" --arg base "$base" --arg h "$head" --argjson dr "$draft" \
          '{forge:$f,number:$n,ref:$r,url:$u,state:"open",draft:$dr,title:$t,body:$b,base:$base,head:$h,head_sha:null,landed:[]}')
        save "$(jq -c --argjson v "$new" '. + [$v]' "$db")"
        echo "$new"
        ;;
      edit)
        [ $# -ge 1 ] || usage pr edit
        n=$1
        shift
        need_pr "$n" > /dev/null
        patch='{}'
        while [ $# -gt 0 ]; do
          case $1 in
            --title) patch=$(printf '%s' "$patch" | jq -c --arg v "$2" '.title=$v'); shift 2 ;;
            --base) patch=$(printf '%s' "$patch" | jq -c --arg v "$2" '.base=$v'); shift 2 ;;
            --body) patch=$(printf '%s' "$patch" | jq -c --arg v "$2" '.body=$v'); shift 2 ;;
            *) usage pr edit "$n" "$@" ;;
          esac
        done
        update "$n" "$patch"
        ;;
      close)
        [ $# -eq 1 ] || usage pr close "$@"
        need_pr "$1" > /dev/null
        update "$1" '{"state":"closed"}'
        ;;
      reopen)
        [ $# -eq 1 ] || usage pr reopen "$@"
        need_pr "$1" > /dev/null
        [ ! -e "$d/reopen_refuse" ] || die "cannot reopen pull request $1"
        update "$1" '{"state":"open"}'
        ;;
      *) usage pr "$sub" "$@" ;;
    esac
    ;;
  *) usage "$cmd" "$@" ;;
esac
