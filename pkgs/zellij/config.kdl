keybinds clear-defaults=true {
    normal {
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt l" { MoveFocus "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }

        bind "Alt Ctrl h" { MovePane "Left"; }
        bind "Alt Ctrl j" { MovePane "Down"; }
        bind "Alt Ctrl k" { MovePane "Up"; }
        bind "Alt Ctrl l" { MovePane "Right"; }

        bind "Alt Tab" { GoToNextTab; }
        bind "Alt Shift Tab" { GoToPreviousTab; }
        bind "Alt Enter" { NewTab; }

        bind "Alt n" { NewPane; }
        bind "Alt v" { NewPane "Right"; }
        bind "Alt z" { NewPane "Down"; }
        bind "Alt s" { NewPane "stacked"; }

        bind "Alt t" { ToggleFocusFullscreen; }
        bind "Alt m" { ToggleFloatingPanes; }
        bind "Alt b" { TogglePaneEmbedOrFloating; }
        bind "Alt i" { TogglePanePinned; }

        bind "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }

        bind "Alt w" { CloseFocus; }
        bind "Alt q" { Quit; }

        bind "Alt g" { SwitchToMode "Locked"; }
        bind "Alt x" { SwitchToMode "Scroll"; }
        bind "Alt f" { SwitchToMode "EnterSearch"; }
        bind "Alt o" { SwitchToMode "Session"; }

        bind "Alt Space" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }
    scroll {
        bind "Alt x" "Esc" { SwitchToMode "Normal"; }
        bind "Alt f" { SwitchToMode "EnterSearch"; }

        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
    }
    entersearch {
        bind "Alt f" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    search {
        bind "Alt f" "Esc" { SwitchToMode "Normal"; }
        bind "Alt x" { SwitchToMode "Scroll"; }
    }
    locked {
        bind "Alt g" "Esc" { SwitchToMode "Normal"; }
    }
    session {
        bind "Alt o" "Esc" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }
}

plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
}

pane_frames false

session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 0

theme "catppuccin-mocha"
default_layout "compact"
show_startup_tips false

web_client {
    font "monospace"
}
