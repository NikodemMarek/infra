# The first mate's additions to the coordinator settings (default.nix deep-merges
# them, so the deny list is the coordinator's plus these, and the rule for edits
# under projectsDir).
{
  permissions.deny = [
    "Agent"

    "Bash(claude:*)"

    "Bash(jj new:*)"
    "Bash(jj squash:*)"
    "Bash(jj split:*)"
    "Bash(jj edit:*)"
    "Bash(jj describe:*)"
    "Bash(jj commit:*)"
    "Bash(jj rebase:*)"
    "Bash(jj abandon:*)"
    "Bash(jj restore:*)"
    "Bash(jj upload:*)"
    "Bash(jj sync:*)"
    "Bash(jj undo:*)"
    "Bash(jj absorb:*)"
    "Bash(jj metaedit:*)"
    "Bash(jj duplicate:*)"
    "Bash(jj revert:*)"
    "Bash(jj op restore:*)"
    "Bash(jj op revert:*)"
    "Bash(jj op abandon:*)"
    "Bash(jj git push:*)"
    "Bash(jj bookmark set:*)"
    "Bash(jj bookmark create:*)"
    "Bash(jj bookmark move:*)"
    "Bash(jj bookmark delete:*)"
    "Bash(jj bookmark rename:*)"
    "Bash(jj bookmark forget:*)"
    "Bash(jj util exec:*)"
    # The repository flags would let any of the above through with another prefix.
    "Bash(jj -R *)"
    "Bash(jj --repository *)"
    "Bash(jj-upload:*)"

    "Bash(git commit:*)"
    "Bash(git push:*)"
    "Bash(git reset:*)"
    "Bash(git checkout:*)"
    "Bash(git switch:*)"
    "Bash(git rebase:*)"
    "Bash(git merge:*)"
    "Bash(git cherry-pick:*)"
    "Bash(git stash:*)"
    "Bash(git branch -D:*)"
    "Bash(git tag:*)"
    "Bash(git -C *)"
    "Bash(git -c *)"

    "Bash(forge pr create:*)"
    "Bash(forge pr edit:*)"
    "Bash(forge pr close:*)"
    "Bash(forge pr reopen:*)"
    "Bash(forge pr review:*)"
    "Bash(forge upload:*)"

    "Bash(glab mr create:*)"
    "Bash(glab mr update:*)"
    "Bash(glab mr close:*)"
    "Bash(glab mr reopen:*)"
    "Bash(glab mr delete:*)"
    "Bash(glab mr rebase:*)"
    "Bash(glab mr revoke:*)"
    "Bash(glab mr checkout:*)"
    "Bash(glab mr approve:*)"
    "Bash(glab mr merge:*)"
    "Bash(glab api *-X*)"
    "Bash(glab api *--method*)"
    "Bash(glab api *-f *)"
    "Bash(glab api *-F *)"
    "Bash(glab api *--field*)"
    "Bash(glab api *--raw-field*)"
    "Bash(glab api *--input*)"

    "Bash(gh pr create:*)"
    "Bash(gh pr edit:*)"
    "Bash(gh pr close:*)"
    "Bash(gh pr reopen:*)"
    "Bash(gh pr merge:*)"
    "Bash(gh pr ready:*)"
    "Bash(gh pr update-branch:*)"
    "Bash(gh pr checkout:*)"
    "Bash(gh api *-X*)"
    "Bash(gh api *--method*)"
    "Bash(gh api *-f *)"
    "Bash(gh api *-F *)"
    "Bash(gh api *--field*)"
    "Bash(gh api *--raw-field*)"
    "Bash(gh api *--input*)"
  ];
}
