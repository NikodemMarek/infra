# <subject> <handler>: the handler gets each event on the subject: the event JSON on
# stdin, its type in $ER_TYPE. Handlers: commands of the event-handlers package or
# absolute paths. The leaf link only denies events.> (see pkgs/nats-server/nats.conf):
# any subject outside events. is reachable from the cluster.
events.claude.> event-handler-notify-normal
events.sudo.> event-handler-notify-normal
events.task.started event-handler-notify-normal
events.task.failed event-handler-notify-normal
events.task.new event-handler-task
events.session.message event-handler-session-message
events.claude.> event-handler-inbox
events.sudo.> event-handler-inbox
events.task.failed event-handler-inbox

# untrusted, from the cluster: the handler keeps only project/title/body
remote.notify.> event-handler-remote-notify
